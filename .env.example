# Konektron Research API — copie para .env (o .env não vai para o Git)
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug
APP_URL=http://localhost:5173
API_URL=http://localhost:3333

# MySQL 5.7 / Percona Server da hospedagem (cPanel › Acesso remoto ao banco de dados)
# Desenvolvimento: libere o IP público desta máquina no cPanel e aponte para o servidor.
# Heroku: DB_HOST=127.0.0.1 (ponta local do fixie-wrench) e DB_REMOTE_HOST=<servidor>.
DB_HOST=<IP ou domínio do servidor MySQL>
DB_PORT=3306
DB_NAME=<usuario_cpanel>_pesquisa_dev
DB_USER=<usuario_cpanel>_dev
DB_PASSWORD=troque_esta_senha
DB_SSL=false
DB_POOL_MAX=5
# Usuário só para migrações (fase release do Heroku). Vazio = usa DB_USER.
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# Só no Heroku, lidos por bin/db-connect.sh
DB_REMOTE_HOST=
DB_REMOTE_PORT=3306

# JWT (gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:5173

# Arquivos: local (desenvolvimento) ou gcs (obrigatório no Heroku)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
GCS_BUCKET=
GCS_PROJECT_ID=
GCS_CREDENTIALS_JSON=
# STORAGE_DRIVER=ftp: arquivos numa pasta da hospedagem (HostGator/cPanel), servidos só pela API
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=true
FTP_TLS_INSECURE=false
# HostGator: o certificado do FTP é *.hostgator.com.br; informe o nome do servidor (DNS reverso do IP,
# ex.: br82-ip12.hostgator.com.br) para verificar o TLS sem desligar a checagem
FTP_TLS_SERVERNAME=
# / = pasta inicial da conta FTP (conta do cPanel criada já presa à pasta de destino)
FTP_BASE_PATH=/public_html/Orkneytech_Admin/Storage/Konektron-Research
FTP_MAX_CONEXOES=2

# Tradução automática dos resumos: mymemory (padrão, sem chave), deepl, libretranslate ou desligado
TRADUCAO_PROVEDOR=mymemory
MYMEMORY_EMAIL=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# E-mail transacional (vazio = e-mails só aparecem no log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Konektron Research <nao-responda@konektron.com.br>"

# Chrome para os PDFs (no Heroku vem do buildpack Chrome for Testing)
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
WORKER_POLL_MS=2000
# true: o web também processa a fila (Heroku sem dyno worker)
WORKER_EMBUTIDO=false
