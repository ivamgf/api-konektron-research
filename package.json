{
  "name": "api-konektron-research",
  "version": "1.0.0",
  "description": "API do Konektron Research — cadastro e elaboração de pesquisas científicas",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#database/*": "./src/database/*",
    "#jobs/*": "./src/jobs/*",
    "#middlewares/*": "./src/middlewares/*",
    "#modules/*": "./src/modules/*",
    "#pdf/*": "./src/pdf/*",
    "#services/*": "./src/services/*",
    "#shared/*": "./src/shared/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "dev:worker": "node --watch src/worker.ts",
    "start": "node src/server.ts",
    "worker": "node src/worker.ts",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:status": "knex migrate:status",
    "migrate:make": "knex migrate:make -x js",
    "seed": "knex seed:run",
    "db:check": "node scripts/db-check.js",
    "db:routines": "node scripts/db-routines.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test \"tests/*.test.*\"",
    "heroku-postbuild": "bash bin/install-fixie-wrench.sh",
    "docs:openapi": "node scripts/openapi.js",
    "docs:check": "node scripts/openapi.js --check"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.5",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "puppeteer-core": "^24.15.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^9.30.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
